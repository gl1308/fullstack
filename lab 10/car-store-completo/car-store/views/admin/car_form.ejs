<%- include('../partials/header') %>

<div class="center">

<h1><%= car ? 'Editar Carro' : 'Novo Carro' %></h1>

<form action="<%= car ? '/cars/admin/cars/' + car._id : '/cars/admin/cars' %>" method="POST">

<input type="text" name="marca" placeholder="Marca" value="<%= car ? car.marca : '' %>" required>

<input type="text" name="modelo" placeholder="Modelo" value="<%= car ? car.modelo : '' %>" required>

<input type="number" name="ano" placeholder="Ano" value="<%= car ? car.ano : '' %>" required>

<input type="number" name="qtde_disponivel" placeholder="Quantidade" value="<%= car ? car.qtde_disponivel : '' %>" required>

<button type="submit">Salvar</button>

</form>

</div>

<%- include('../partials/footer') %>