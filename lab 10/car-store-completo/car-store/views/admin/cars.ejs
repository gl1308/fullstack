<%- include('../partials/header') %>

<h1>Gerência de Carros</h1>

<a href="/cars/admin/cars/new" class="btn">Novo Carro</a>

<table>
<tr>
<th>Marca</th>
<th>Modelo</th>
<th>Ano</th>
<th>Quantidade</th>
<th>Ações</th>
</tr>

<% cars.forEach(car => { %>
<tr>
<td><%= car.marca %></td>
<td><%= car.modelo %></td>
<td><%= car.ano %></td>
<td><%= car.qtde_disponivel %></td>

<td>

<a href="/cars/admin/cars/<%= car._id %>/edit">Editar</a>

<form action="/cars/admin/cars/<%= car._id %>/delete" method="POST" style="display:inline;">
<button type="submit">Remover</button>
</form>

<form action="/cars/admin/cars/<%= car._id %>/sell" method="POST" style="display:inline;">
<button type="submit">Vender</button>
</form>

</td>
</tr>
<% }) %>

</table>

<%- include('../partials/footer') %>