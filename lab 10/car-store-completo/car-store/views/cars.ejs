<%- include('partials/header') %>

<h1>Carros Disponíveis</h1>

<table>
<tr>
<th>Marca</th>
<th>Modelo</th>
<th>Ano</th>
<th>Quantidade</th>
</tr>

<% cars.forEach(car => { %>
<tr>
<td><%= car.marca %></td>
<td><%= car.modelo %></td>
<td><%= car.ano %></td>
<td>
<%= car.qtde_disponivel <= 0 ? 'ESGOTADO' : car.qtde_disponivel %>
</td>
</tr>
<% }) %>

</table>

<%- include('partials/footer') %>